{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "out/**",
        ".output/**",
        ".wxt/**",
        "build/**"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "test:spec:feat": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "test:spec": {
      "cache": false
    },
    "test:spec:seokit": {
      "cache": false
    },
    "test:spec:analytics": {
      "cache": false
    },
    "test:spec:visual": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "shots": {
      "cache": false
    },
    "screenshots": {
      "cache": false
    },
    "promo-tiles": {
      "cache": false
    },
    "render": {
      "cache": false,
      "outputs": ["../extapp/store/chrome/**"]
    },
    "test:unit": {
      "cache": false
    }
  }
}
