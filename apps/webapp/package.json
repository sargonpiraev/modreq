{
  "name": "webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "check-types": "tsc --noEmit",
    "dev": "next dev --port 3000",
    "lint": "eslint",
    "test": "tsc --noEmit",
    "test:analytics": "playwright test --project=analytics",
    "test:cwv": "playwright test --project=cwv",
    "test:functional": "playwright test --project=functional",
    "test:seo": "playwright test --project=seo",
    "test:spec": "playwright test --project=functional --project=seo --project=analytics",
    "test:visual": "playwright test --project=visual --project=visual-mobile"
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sargonpiraev/seokit": "^0.9.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "5.9.2"
  },
  "optionalDependencies": {
    "@next/swc-linux-x64-gnu": "16.2.11"
  }
}
