{
  "name": "webapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check-types": "tsc --noEmit",
    "dev": "next dev --port 3000",
    "lint": "eslint",
    "test": "tsc --noEmit",
    "test:spec": "playwright test --grep '@feat|@seokit|@analytics'",
    "test:spec:analytics": "playwright test --grep @analytics",
    "test:spec:feat": "playwright test --grep @feat",
    "test:spec:perf": "playwright test --grep @perf",
    "test:spec:seokit": "playwright test --grep @seokit",
    "test:spec:visual": "playwright test --grep @visual",
    "test:unit": "jest --passWithNoTests"
  },
  "dependencies": {
    "next": "16.2.11",
    "next-intl": "^4.13.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sargonpiraev/seokit": "^0.9.0",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "jest": "^30.4.2",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.11",
    "typescript": "5.9.2"
  },
  "optionalDependencies": {
    "@next/swc-linux-x64-gnu": "16.2.11"
  }
}
