{
  "name": "modreq",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "npm run test:check-types && npm run test:lint && npm run test:unit && npm run test:spec",
    "screenshots": "npm run screenshots --workspace=imgapp --",
    "promo-tiles": "npm run promo-tiles --workspace=imgapp --",
    "shots": "npm run shots --workspace=imgapp --",
    "render:video": "turbo run render --filter=vidapp",
    "prepare": "lefthook install",
    "test:unit": "turbo run test",
    "test:lint": "npm run lint",
    "test:check-types": "npm run check-types",
    "test:functional": "npm run test:functional --workspace=webapp && npm run test:functional --workspace=extapp",
    "test:seo": "npm run test:seo --workspace=webapp",
    "test:analytics": "npm run test:analytics --workspace=webapp",
    "test:spec": "npm run test:spec --workspace=webapp && npm run test:spec --workspace=extapp",
    "test:visual": "npm run test:visual --workspace=webapp && npm run test:visual --workspace=extapp",
    "test:format": "prettier --check \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "lefthook": "^2.1.9",
    "prettier": "^3.7.4",
    "semantic-release": "^25.0.8",
    "turbo": "^2.10.0",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.4",
  "overrides": {
    "@eslint/plugin-kit": "0.3.4",
    "adm-zip": "0.6.0",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "esbuild": "0.28.1",
    "fx-runner": "1.5.0",
    "picomatch": "4.0.5",
    "shell-quote": "1.10.0",
    "tar": "7.5.20",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "web-ext-run": {
      "fx-runner": "1.5.0",
      "tmp": "0.2.7",
      "node-notifier": {
        "uuid": "11.1.1"
      }
    },
    "firefox-profile": {
      "adm-zip": "0.6.0"
    },
    "brace-expansion@5": "5.0.9"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "$schema": "../schema/project__package.json"
}
