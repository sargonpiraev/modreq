# pulumi/.env is a symlink to the workspace vault (`npm run link:envs` from meta).
# Key names only — no secrets. CI gates this file, not gitignored `.env`.
# Pack keys: `@sargonpiraev/pulumi-apps` webapp + extapp env (Webapp, Extapp).

PULUMI_BACKEND_URL=file://$PWD
PULUMI_CONFIG_PASSPHRASE=
PULUMI_LOG_LEVEL=
GOOGLE_SERVICE_ACCOUNT_KEY=
GCP_SERVICE_ACCOUNT_KEY=
VERCEL_API_TOKEN=
TELEGRAM_PULSEX_BOT_TOKEN=
GITHUB_TOKEN=
